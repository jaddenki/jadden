---
import BaseHead from "../components/BaseHead.astro";
import CornerNav from "../components/CornerNav.astro";
import LikingList from "../components/LikingList.astro";
import SiteFooter from "../components/SiteFooter.astro";
import UsesList from "../components/UsesList.astro";
import { SITE_TITLE } from "../consts";
import { fetchProfileEntries } from "../lib/arena";
import "../styles/global.css";

// Opt this single route into on-demand rendering + ISR (see astro.config.mjs).
// The rest of the site stays fully static.
export const prerender = false;

const ARENA_PROFILE_SLUG = "jadden-picardal";
const ARENA_PROFILE_URL = `https://www.are.na/${ARENA_PROFILE_SLUG}`;

// Runs per revalidation (not per request). The profile feed includes posts from
// every channel and returns an empty list if Are.na is temporarily unavailable.
const entries = await fetchProfileEntries(ARENA_PROFILE_SLUG);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={`now ${SITE_TITLE}`}
			description="What I'm using and what I'm liking lately."
		/>
	</head>
	<body class="now-page">
		<CornerNav current="now" />
		<main class="homepage-container now-layout">
			<div class="now-uses">
				<UsesList />
			</div>
			<div class="now-liking">
				<LikingList entries={entries} sourceUrl={ARENA_PROFILE_URL} />
			</div>
		</main>

		<SiteFooter />
		<script>
			// Fade thumbnails in once they load instead of snapping in when the
			// network resolves (see .liking-thumb / .img-loaded in global.css).
			for (const img of document.querySelectorAll<HTMLImageElement>(
				".liking-thumb",
			)) {
				if (img.complete) {
					img.classList.add("img-loaded");
				} else {
					const reveal = () => img.classList.add("img-loaded");
					img.addEventListener("load", reveal, { once: true });
					img.addEventListener("error", reveal, { once: true });
				}
			}
		</script>
	</body>
</html>
