        <SiteFooter />
        <script>
            document.addEventListener(
                "wheel",
                (e) => {
                    const gallery =
                        document.querySelector<HTMLElement>(
                            ".projects-gallery",
                        );
                    if (!gallery) return;
                    if (e.target instanceof Node && gallery.contains(e.target))
                        return;
                    gallery.scrollBy({ top: e.deltaY, behavior: "auto" });
                },
                { passive: true },
            );
        </script>
        <script>
            const items = document.querySelectorAll<HTMLElement>(
                ".project-list li[data-grid-index]",
            );
            const tiles = document.querySelectorAll<HTMLElement>(".gallery-grid > *");
            const gallery = document.querySelector(".gallery-grid");

            const clearGrid = () => {
                gallery?.classList.remove("grid-dimmed");
                tiles.forEach((tile) => tile.classList.remove("grid-highlight"));
            };

            items.forEach((item) => {
                const link = item.querySelector("a");
                const index = Number(item.dataset.gridIndex);
                if (!link || !Number.isFinite(index)) return;
                link.addEventListener("mouseenter", () => {
                    gallery?.classList.add("grid-dimmed");
                    tiles[index]?.classList.add("grid-highlight");
                    tiles[index]?.scrollIntoView({ behavior: "smooth", block: "center" });
                });
                link.addEventListener("mouseleave", clearGrid);
            });
        </script>
        <script>
            const loadingScreen = document.getElementById("loading-screen");

            const waitForMedia = (media: Element) => {
                if (media instanceof HTMLImageElement) {
                    if (media.complete) {
                        return media.naturalWidth > 0
                            ? media.decode().catch(() => {})
                            : Promise.resolve();
                    }

                    return new Promise<void>((resolve) => {
                        media.addEventListener("load", () => {
                            void media.decode().catch(() => {}).finally(resolve);
                        }, { once: true });
                        media.addEventListener("error", () => resolve(), { once: true });
                    });
                }

                if (media instanceof HTMLVideoElement) {
                    if (media.readyState >= HTMLMediaElement.HAVE_CURRENT_DATA) {
                        return Promise.resolve();
                    }

                    media.load();
                    return new Promise<void>((resolve) => {
                        media.addEventListener("loadeddata", () => resolve(), { once: true });
                        media.addEventListener("error", () => resolve(), { once: true });
                    });
                }

                return Promise.resolve();
            };

            const finishLoading = () => {
                sessionStorage.setItem("hasVisited", "true");
                document.body.classList.remove("page-intro-pending");

                if (!loadingScreen) return;
                loadingScreen.classList.add("fade-out");

                const removeLoader = () => {
                    loadingScreen.remove();
                    const liveRegion = document.getElementById("page-ready");
                    if (liveRegion) liveRegion.textContent = "Page loaded";
                };

                loadingScreen.addEventListener("transitionend", removeLoader, {
                    once: true,
                });
                setTimeout(() => {
                    if (loadingScreen.isConnected) removeLoader();
                }, 300);
            };

            if (sessionStorage.getItem("hasVisited")) {
                loadingScreen?.remove();
            } else {
                const media = document.querySelectorAll("[data-loader-media]");
                const mediaReady = Promise.allSettled(
                    Array.from(media, waitForMedia),
                );
                const timeout = new Promise<void>((resolve) =>
                    setTimeout(resolve, 10000),
                );

                void Promise.race([mediaReady, timeout]).then(finishLoading);
            }
        </script>
    </body>
</html>
