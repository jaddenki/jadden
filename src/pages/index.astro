const isVideoUrl = (url: string) => /\.(webm)(\?|$)/i.test(url);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link
            rel="preload"
            as={isVideoUrl(projects[0].src) ? "video" : "image"}
            href={projects[0].src}
        />
    </head>
    <body>
        <script is:inline>
            if (sessionStorage.getItem("hasVisited"))
                document.body.classList.add("loading-skip");
        </script>
        <div id="loading-screen">
            <div class="loading-content">
                <div class="loading-pixels" aria-hidden="true">
                    <span class="loading-pixel"></span>
                    <span class="loading-pixel"></span>
                    <span class="loading-pixel"></span>
                </div>
                <p class="loading-text">Let's take a deep breath...</p>
            </div>
        </div>
        <div id="page-ready" aria-live="polite" class="sr-only"></div>
        <CornerNav current="home" />
        <main class="homepage-container">
            <div class="content text-reveal">
                <p style="--reveal-order: 0">
                    Hi, I'm Jadden Picardal (she/her)
                </p>
                <!-- span class="email">jadden [at] jam [dot] ms</span> -->
                <p style="--reveal-order: 1">
                    I'm a programmer and designer, studying computer engineering
                    at
                    <HoverPreviewLink
                        client:visible
                        href="https://www.purdue.edu/"
                        target="_blank"
                        previewSrc="/img/previews/purdue.webp"
                        previewAlt="Purdue">Purdue</HoverPreviewLink
                    >
                    <span class="inline-text">(Fall 2026)</span>
                </p>

                <p style="--reveal-order: 2">
                    Currently, I'm in SF at
                    <InlineAvatar
                        src="https://avatars.githubusercontent.com/u/107880645?v=4"
                        alt="Infisical logo"
                        width={20}
                        height={20}
                        class="inline-avatar inline-avatar-ring"
                        priority
                    />

                    <HoverPreviewLink
                        client:visible
                        href="https://infisical.com/"
                        target="_blank"
                        previewSrc="/img/previews/infisical.webp"
                        previewAlt="Infisical">Infisical</HoverPreviewLink> as a Design Engineer (Intern #1), crafting the visuals behind security tools that matter
                </p>
                <p style="--reveal-order: 3">
                    Previously, motion + web at <InlineAvatar
                        src="https://avatars.githubusercontent.com/lowercaseclub"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar"
                        priority
                    />
                    <HoverPreviewLink
                        client:visible
                        href="https://lowercase.club/"
                        target="_blank"
                        previewSrc="/img/previews/lowercase.webp"
                        previewAlt="lowercase.club preview"
                        >lowercase</HoverPreviewLink>
                </p>

                <!-- <p>
                    I'm also the Comms Lead and a Designer
                    at <InlineAvatar
                        src="https://www.google.com/s2/favicons?domain=purduehackers.com&sz=64"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar inline-avatar-invert-dark"
                    />
                    <HoverPreviewLink
                        client:visible
                        href="https://purduehackers.com/"
                        target="_blank"
                        previewSrc="/img/previews/ph.webp"
                        previewAlt="purduehackers.com preview"
                    >Purdue Hackers</HoverPreviewLink>, a the coolest community of makers on campus
                </p> -->

                <p style="--reveal-order: 4">
                    I also run <InlineAvatar
                        src="https://www.jam.ms/img/favicon.png"
                        alt="jamms logo"
                        width={20}
                        height={20}
                        class="inline-avatar"
                        priority
                    />
                    <HoverPreviewLink
                        client:visible
                        href="https://jam.ms"
                        target="_blank"
                        previewSrc="/img/previews/jamms.webp"
                        previewAlt="jamms">jamms</HoverPreviewLink>, a creative studio doing branding, games, web, and motion work
                </p>

                <p style="--reveal-order: 4">
                    Links... <HoverPreviewLink
                        client:visible
                        href="https://github.com/jaddenki"
                        target="_blank"
                        previewText="@jaddenki ↗">GitHub</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://www.linkedin.com/in/jadden-picardal"
                        target="_blank"
                        previewText="jadden-picardal ↗"
                        >LinkedIn</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://www.are.na/jadden-picardal/jadden-picardal-s0qvounprtc"
                        target="_blank"
                        previewText="Jadden Picardal ↗">Are.na</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://x.com/igarakii"
                        target="_blank"
                        previewText="@igarakii ↗">Twitter</HoverPreviewLink
                    >
                </p>

                <p style="--reveal-order: 4">Some things I've worked on...</p>

                <ul class="project-list" style="--reveal-order: 6">
                    {
                        projectList.map((p) => {
                            const hasPreview = p.previewSrc || p.previewText;
                            return (
                                <li data-grid-index={p.gridIndex?.join(",")}>
                                    <div class="project-list-row">
                                        <span class="project-list-main">
                                            {hasPreview && p.href ? (
                                                <HoverPreviewLink
                                                    client:visible
                                                    href={p.href}
                                                    target={
                                                        p.href.startsWith("/")
                                                            ? undefined
                                                            : "_blank"
                                                    }
                                                    previewSrc={p.previewSrc}
                                                    previewAlt={p.previewAlt}
                                                    previewText={p.previewText}
                                                >
                                                    {p.name}
                                                </HoverPreviewLink>
                                            ) : p.href ? (
                                                <a href={p.href}>{p.name}</a>
                                            ) : (
                                                <span>{p.name}</span>
                                            )}
                                        </span>
                                        {p.tag && (
                                            <span class="project-tag">
                                                {p.tag}
                                            </span>
                                        )}
                                    </div>
                                </li>
                            );
                        })
                    }
                </ul>
                <p style="--reveal-order: 5">
                    And more! Currently populating this space...
                </p>
            </div>

            <ImageGrid items={projects} eager />
        </main>

        <SiteFooter />
        <script>
            document.addEventListener(
                "wheel",
                (e) => {
                    const gallery =
                        document.querySelector<HTMLElement>(
                            ".projects-gallery",
                        );
                    if (!gallery) return;
                    if (e.target instanceof Node && gallery.contains(e.target))
                        return;
                    gallery.scrollBy({ top: e.deltaY, behavior: "auto" });
                },
                { passive: true },
            );
        </script>
        <script>
            const hasVisited = sessionStorage.getItem("hasVisited");
            const loadingScreen = document.getElementById("loading-screen");
            if (hasVisited && loadingScreen) {
                loadingScreen.remove();
            } else {
                // only for first vidit
                window.addEventListener("load", () => {
                    if (loadingScreen) {
                        sessionStorage.setItem("hasVisited", "true");
                        loadingScreen.classList.add("fade-out");
                        loadingScreen.addEventListener(
                            "transitionend",
                            () => {
                                loadingScreen.remove();
                                const liveRegion =
                                    document.getElementById("page-ready");
                                if (liveRegion)
                                    liveRegion.textContent = "Page loaded";
                            },
                            {
                                once: true,
                            },
                        );
                        setTimeout(() => {
                            if (loadingScreen.isConnected)
                                loadingScreen.remove();
                        }, 700);
                    }
                });
            }
        </script>
        <script>
            const listItems = document.querySelectorAll<HTMLElement>(
                ".project-list li[data-grid-index]",
            );
            const gridTiles =
                document.querySelectorAll<HTMLElement>(".gallery-grid > *");
            const gallery = document.querySelector(".gallery-grid");
            let leaveTimer: ReturnType<typeof setTimeout> | null = null;

            const dispatchToTileVideos = (
                tile: HTMLElement,
                type: "mouseenter" | "mouseleave",
            ) => {
                const videos = tile.querySelectorAll<HTMLVideoElement>(
                    "video.gallery-image",
                );
                for (const video of videos) {
                    video.dispatchEvent(new Event(type, { bubbles: false }));
                }
            };

            const clearGrid = () => {
                gallery?.classList.remove("grid-dimmed");
                for (const tile of gridTiles) {
                    tile.classList.remove("grid-highlight");
                    // Let videos return to their idle / freeze frame state
                    dispatchToTileVideos(tile, "mouseleave");
                }
            };

            for (const li of listItems) {
                const trigger = li.querySelector<HTMLAnchorElement>("a");
                if (!trigger) continue;

                trigger.addEventListener("mouseenter", () => {
                    if (leaveTimer) {
                        clearTimeout(leaveTimer);
                        leaveTimer = null;
                    }
                    const indicesArray = li.dataset
                        .gridIndex!.split(",")
                        .map(Number);
                    const indices = new Set(indicesArray);
                    gallery?.classList.add("grid-dimmed");
                    // Smooth-scroll the first matching tile into view
                    const firstIndex = Math.min(...indicesArray);
                    const targetTile = gridTiles[firstIndex];
                    if (targetTile) {
                        const prefersReduced = window.matchMedia(
                            "(prefers-reduced-motion: reduce)",
                        ).matches;
                        targetTile.scrollIntoView({
                            behavior: prefersReduced ? "instant" : "smooth",
                            block: "center",
                            inline: "nearest",
                        });
                    }
                    for (let i = 0; i < gridTiles.length; i++) {
                        const tile = gridTiles[i];
                        const shouldHighlight = indices.has(i);
                        tile.classList.toggle(
                            "grid-highlight",
                            shouldHighlight,
                        );
                        if (shouldHighlight) {
                            // Trigger the same behavior as hovering the video tile directly
                            dispatchToTileVideos(tile, "mouseenter");
                        } else {
                            dispatchToTileVideos(tile, "mouseleave");
                        }
                    }
                });
                trigger.addEventListener("mouseleave", () => {
                    if (leaveTimer) clearTimeout(leaveTimer);
                    leaveTimer = setTimeout(clearGrid, 75);
                });
            }
        </script>
    </body>
</html>
