---
import BaseHead from "../components/BaseHead.astro";
import { HoverPreviewLink } from "../components/HoverPreviewLink";
import ImageGrid from "../components/ImageGrid.astro";
import InlineAvatar from "../components/InlineAvatar.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import "../styles/global.css";

const projects = [
    {
        src: "/img/front/capytitle.webm",
        alt: "capy title",
        aspectRatio: "16/9",
        freezeTime: 0.6,
        playContinuously: true,
    },
    {
        src: "/img/front/capycapy.webm",
        alt: "capys jumping out",
        aspectRatio: "16/9",
        freezeTime: 0.6,
        playContinuously: true,
    },
    {
        src: "/img/front/infrared.webm",
        alt: "infrared",
        aspectRatio: "1/1",
        freezeTime: 0.6,
        // playContinuously: true,
    },
    {
        src: "/img/front/hello_world.webm",
        alt: "hello world",
        aspectRatio: "1/1",
        freezeTime: 1.1,
    },
    {
        src: "/img/front/fish.webm",
        alt: "fish",
        aspectRatio: "1/1",
        freezeTime: .8,
    },
    {
        src: "/img/front/loco.webm",
        alt: "go loco",
        aspectRatio: "1/1",
        freezeTime: 3.4,
    },
    // {
    // 	src: '/img/front/capy-text.webm', not spoiling
    // 	alt: 'capy text',
    // 	aspectRatio: '16/9',
    // },
    // {
    // 	src: '/img/front/capy-ui.webm',
    // 	alt: 'capy ui',
    // 	aspectRatio: '16/9',
    // },
    {
        src: "/img/front/respellai.webm",
        alt: "respell ai video",
        aspectRatio: "16/9",
        freezeTime: .5,
        // playContinuously: true,
    },
    {
        src: "/img/front/stl.webm",
        alt: "spread the love video",
        aspectRatio: "16/9",
        freezeTime: 2.7,
    },
    {
        src: "/img/front/indigo.webm",
        alt: "indigo",
        aspectRatio: "1/1",
        freezeTime: 0.5,
        // playContinuously: true,
    },
    {
        src: "/img/front/anklyosaur.webm",
        alt: "ankyosaur",
        aspectRatio: "1/1",
        freezeTime: 2.5,
    },
    {
        src: "/img/front/glass.webm",
        alt: "glass",
        aspectRatio: "1/1",
        freezeTime: 3.3,
    },
    {
        src: "/img/front/ridelikebike.webm",
        alt: "drop it",
        aspectRatio: "1/1",
        freezeTime: 1.8,
    },
];

interface ProjectListItem {
    name: string;
    href?: string;
    gridIndex?: number[];
    previewSrc?: string;
    previewAlt?: string;
    previewText?: string;
}

const projectList: ProjectListItem[] = [
    { name: "Capy", gridIndex: [0, 1], href: "https://x.com/capydotai/status/2031430074940195126", previewText: "Launch Video ↗", previewAlt: "capy" },
    { name: "PixelHackers (This font!)", href: "https://x.com/igarakii/status/2029082607711863007?s=20", previewText: "Still working on it...↗" },
    { name: "etea.cafe", href: "https://etea.cafe", previewText: "Daily Web Game ↗" },
    // { name: "etea.cafe", href: "https://etea.cafe", previewSrc: "/img/previews/lowercase.webp", previewAlt: "etea.cafe" },
    { name: "Spread the Love", href: "https://store.steampowered.com/app/3852520/Spread_The_Love/", previewText: "Steam ↗" },
];

const isVideoUrl = (url: string) => /\.(webm)(\?|$)/i.test(url);
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link
            rel="preload"
            as={isVideoUrl(projects[0].src) ? "video" : "image"}
            href={projects[0].src}
        />
    </head>
    <body>
        <script is:inline>
            if (sessionStorage.getItem("hasVisited"))
                document.body.classList.add("loading-skip");
        </script>
        <div id="loading-screen">
            <div class="loading-content">
                <div class="loading-pixels" aria-hidden="true">
                    <span class="loading-pixel"></span>
                    <span class="loading-pixel"></span>
                    <span class="loading-pixel"></span>
                </div>
                <p class="loading-text">Let's take a deep breath...</p>
            </div>
        </div>
        <main class="homepage-container">
            <div class="content">
                <p>
                    Hi, I'm <HoverPreviewLink
                        client:visible
                        href="/about"
                        data-astro-prefetch
                        previewText="about me >"
                    >Jadden Picardal</HoverPreviewLink> <InlineAvatar
                        src="https://github.com/jaddenki.png"
                        alt="jaddens gh"
                        width={16}
                        height={16}
                        class="inline-avatar"
                        priority
                    />
                </p>
                <!-- span class="email">jadden [at] jam [dot] ms</span> -->
                <p>
                    I'm a programmer and designer, finishing up my BSCompeE at 
                    <HoverPreviewLink
                        client:visible
                        href="https://www.purdue.edu/"
                        target="_blank"
                        previewSrc="/img/previews/purdue.webp"
                        previewAlt="Purdue"
                    >Purdue</HoverPreviewLink> <span class="inline-text">(Fall 2026)</span>
                </p>

                <p>
                    Currently, I'm making unconventional branding for
                    startups at <InlineAvatar
                        src="https://github.com/lowercaseclub.png"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar"
                    />
                    <HoverPreviewLink
                        client:visible
                        href="https://lowercase.club/"
                        target="_blank"
                        previewSrc="/img/previews/lowercase.webp"
                        previewAlt="lowercase.club preview"
                    >lowercase</HoverPreviewLink>, focusing on motion + web design
                </p>

                <p>
                    I'm also the Comms Lead and a Designer
                    at <InlineAvatar
                        src="https://www.google.com/s2/favicons?domain=purduehackers.com&sz=64"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar inline-avatar-invert-dark"
                    />
                    <HoverPreviewLink
                        client:visible
                        href="https://purduehackers.com/"
                        target="_blank"
                        previewSrc="/img/previews/ph.webp"
                        previewAlt="purduehackers.com preview"
                    >Purdue Hackers</HoverPreviewLink>, a the coolest community of makers on campus
                </p>

                <p>
                    Links... <HoverPreviewLink
                        client:visible
                        href="https://github.com/jaddenki"
                        target="_blank"
                        previewText="@jaddenki ↗"
                    >GitHub</HoverPreviewLink>, <HoverPreviewLink
                        client:visible
                        href="https://www.linkedin.com/in/jadden-picardal"
                        target="_blank"
                        previewText="jadden-picardal ↗"
                    >LinkedIn</HoverPreviewLink>, <HoverPreviewLink
                        client:visible
                        href="https://www.are.na/jadden-picardal/jadden-picardal-s0qvounprtc"
                        target="_blank"
                        previewText="Jadden Picardal ↗"
                    >Are.na</HoverPreviewLink>, <HoverPreviewLink
                        client:visible
                        href="https://x.com/igarakii"
                        target="_blank"
                        previewText="@igarakii ↗"
                    >Twitter</HoverPreviewLink>
                </p>

                <p>Some things I've worked on...</p>

                <ul class="project-list">
                    {projectList.map((p) => {
                        const hasPreview = p.previewSrc || p.previewText;
                        return (
                            <li data-grid-index={p.gridIndex?.join(',')}>
                                {hasPreview && p.href ? (
                                    <HoverPreviewLink
                                        client:visible
                                        href={p.href}
                                        target={p.href.startsWith('/') ? undefined : '_blank'}
                                        previewSrc={p.previewSrc}
                                        previewAlt={p.previewAlt}
                                        previewText={p.previewText}
                                    >{p.name}</HoverPreviewLink>
                                ) : p.href ? (
                                    <a href={p.href}>{p.name}</a>
                                ) : (
                                    <span>{p.name}</span>
                                )}
                            </li>
                        );
                    })}
                </ul>
                <p>And more! Currently populating this space...</p>
            </div>

            <ImageGrid items={projects} eager />
        </main>

        <footer>
            <ThemeToggle />
            <nav class="webring-nav">
                <a
                    href="https://ring.purduehackers.com/previous?host=https://www.jaddens.page"
                    class="webring-link"
                    title="Previous site"
                >
                    &lt;
                </a>
                <a
                    href="https://ring.purduehackers.com/"
                    class="webring-link webring-logo"
                    title="Purdue Hackers Webring"
                >
                    Purdue Hackers
                </a>
                <a
                    href="https://ring.purduehackers.com/next?host=https://www.jaddens.page"
                    class="webring-link"
                    title="Next site"
                >
                    &gt;
                </a>
            </nav>
        </footer>
        <script>
            const hasVisited = sessionStorage.getItem("hasVisited");
            const loadingScreen = document.getElementById("loading-screen");
            if (hasVisited && loadingScreen) {
                loadingScreen.remove();
            } else {
                // only for first vidit
                window.addEventListener("load", () => {
                    if (loadingScreen) {
                        sessionStorage.setItem("hasVisited", "true");
                        loadingScreen.classList.add("fade-out");
                        loadingScreen.addEventListener("transitionend", () => {
                            loadingScreen.remove();
                        }, {
                            once: true,
                        });
                        setTimeout(() => {
                            if (loadingScreen.isConnected) loadingScreen.remove();
                        }, 700);
                    }
                });
            }
        </script>
        <script>
            const listItems = document.querySelectorAll<HTMLElement>(".project-list li[data-grid-index]");
            const gridTiles = document.querySelectorAll(".gallery-grid > *");
            const gallery = document.querySelector(".gallery-grid");
            let leaveTimer: ReturnType<typeof setTimeout> | null = null;

            const clearGrid = () => {
                gallery?.classList.remove("grid-dimmed");
                for (const tile of gridTiles) tile.classList.remove("grid-highlight");
            };

            for (const li of listItems) {
                li.addEventListener("mouseenter", () => {
                    if (leaveTimer) { clearTimeout(leaveTimer); leaveTimer = null; }
                    const indices = new Set(
                        li.dataset.gridIndex!.split(",").map(Number)
                    );
                    gallery?.classList.add("grid-dimmed");
                    for (let i = 0; i < gridTiles.length; i++) {
                        gridTiles[i].classList.toggle("grid-highlight", indices.has(i));
                    }
                });
                li.addEventListener("mouseleave", () => {
                    if (leaveTimer) clearTimeout(leaveTimer);
                    leaveTimer = setTimeout(clearGrid, 75);
                });
            }
        </script>
    </body>
</html>
