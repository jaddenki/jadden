const formatDate = (date: string) => {
    const [year, month] = date.split("-");
    return `${month ?? "0N"} ${year}`;
};

---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
        <link rel="preload" as="image" href={projects[0].poster} media="(min-width: 769px)" />
    </head>
    <body>
        <CornerNav current="home" />
        <main class="homepage-container">
            <div class="content text-reveal">
                <p style="--reveal-order: 0">
                    Hi, I'm Jadden Picardal <span class="email">(she/her)</span>
                </p>
                <!-- span class="email">jadden [at] jam [dot] ms</span> -->
                <p style="--reveal-order: 1">
                    I'm a programmer and designer, studying computer engineering
                    at{" "}
                    <HoverPreviewLink
                        client:visible
                        href="https://www.purdue.edu/"
                        target="_blank"
                        previewSrc="/img/previews/purdue.webp"
                        previewAlt="Purdue">Purdue</HoverPreviewLink
                    >
                    {" "}
                    <span class="inline-text">(Fall 2026)</span>
                </p>
                <p style="--reveal-order: 2">
                    I love {""}
                    <HoverPreviewLink
                        client:visible
                        href="https://x.com/igarakii/status/2034432270375801233"
                        target="_blank"
                        previewText="my showreel"
                    >
                        motion design
                    </HoverPreviewLink>
                    {""} and making things move
                </p>

                <p style="--reveal-order: 2">
                    I'm a design engineer at <InlineAvatar
                        src="https://avatars.githubusercontent.com/u/107880645?v=4"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar inline-avatar-ring"
                    /><HoverPreviewLink
                        client:visible
                        href="https://infisical.com"
                        target="_blank"
                        previewSrc="/img/previews/infisical.webp"
                        previewAlt="Infisical homepage"
                    >Infisical</HoverPreviewLink> & I'm making corners of the world wide web stick with <InlineAvatar
                        src="https://avatars.githubusercontent.com/fruitjamms"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar"
                    /><HoverPreviewLink
                        client:visible
                        href="https://jam.ms"
                        target="_blank"
                        previewSrc="/img/previews/jamms.webp"
                        previewAlt="jam.ms preview"
                    >jamms</HoverPreviewLink>
                    <br />
                    Previously, I did motion + web with <InlineAvatar
                        src="https://avatars.githubusercontent.com/u/142772763?v=4"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar"
                    /><HoverPreviewLink
                        client:visible
                        href="https://lowercase.club"
                        target="_blank"
                        previewText="lowercase.club ↗"
                    >lowercase</HoverPreviewLink>
                </p>

                <!-- <p>
                    I'm also the Comms Lead and a Designer
                    at <InlineAvatar
                        src="https://www.google.com/s2/favicons?domain=purduehackers.com&sz=64"
                        alt=""
                        width={20}
                        height={20}
                        class="inline-avatar inline-avatar-invert-dark"
                    />
                    <HoverPreviewLink
                        client:visible
                        href="https://purduehackers.com/"
                        target="_blank"
                        previewSrc="/img/previews/ph.webp"
                        previewAlt="purduehackers.com preview"
                    >Purdue Hackers</HoverPreviewLink>, a the coolest community of makers on campus
                </p> -->

                <p style="--reveal-order: 2">
                    For project inquiries: <span class="email"
                        >jadden [at] jam [dot] ms</span
                    ><br />
                    <span class="email">I'm booked for Q3, booking for Q4</span>
                </p>

                <p style="--reveal-order: 3">
                    Links... <HoverPreviewLink
                        client:visible
                        href="https://github.com/jaddenki"
                        target="_blank"
                        previewText="@jaddenki ↗">GitHub</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://www.linkedin.com/in/jadden-picardal"
                        target="_blank"
                        previewText="jadden-picardal ↗"
                        >LinkedIn</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://www.are.na/jadden-picardal/jadden-picardal-s0qvounprtc"
                        target="_blank"
                        previewText="Jadden Picardal ↗">Are.na</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://x.com/igarakii"
                        target="_blank"
                        previewText="@igarakii ↗">Twitter</HoverPreviewLink
                    >
                </p>
                <p style="--reveal-order: 5">
                    Feel free to scroll through my selected works <br /> Here are
                    some other links to other projects:
                </p>
                <ul class="project-list" style="--reveal-order: 5">
                    {projectList.map((project) => {
                        const hasPreview = project.previewSrc || project.previewSrcs || project.previewText;
                        return (
                            <li data-grid-index={project.gridIndex}>
                                <span class="project-date">{formatDate(project.date)}</span>
                                {!hasPreview ? (
                                    project.href ? (
                                        <a href={project.href} target="_blank">{project.name}</a>
                                    ) : (
                                        <span class="project-name">{project.name}</span>
                                    )
                                ) : (
                                    <HoverPreviewLink
                                        client:visible
                                        href={project.href}
                                        target="_blank"
                                        previewSrc={project.previewSrc}
                                        previewSrcs={project.previewSrcs}
                                        previewAlt={project.previewAlt}
                                        previewText={project.previewText}
                                    >
                                        {project.name}
                                    </HoverPreviewLink>
                                )}
                                <span class="project-tag">{project.tag}</span>
                            </li>
                        );
                    })}
                </ul>
                <p style="--reveal-order: 7">
                    And the list goes on... remind me to add more...
                </p>
            </div>

            <ImageGrid items={projects} />
        </main>

        <SiteFooter />
        <script>
            document.addEventListener(
                "wheel",
                (e) => {
                    const gallery =
                        document.querySelector<HTMLElement>(
                            ".projects-gallery",
                        );
                    if (!gallery) return;
                    if (e.target instanceof Node && gallery.contains(e.target))
                        return;
                    gallery.scrollBy({ top: e.deltaY, behavior: "auto" });
                },
                { passive: true },
            );
        </script>
        <script>
            const items = document.querySelectorAll<HTMLElement>(
                ".project-list li[data-grid-index]",
            );
            const tiles = document.querySelectorAll<HTMLElement>(".gallery-grid > *");
            const gallery = document.querySelector(".gallery-grid");

            const clearGrid = () => {
                gallery?.classList.remove("grid-dimmed");
                tiles.forEach((tile) => tile.classList.remove("grid-highlight"));
            };

            items.forEach((item) => {
                const link = item.querySelector("a, .project-name");
                const index = Number(item.dataset.gridIndex);
                if (!link || !Number.isFinite(index)) return;
                link.addEventListener("mouseenter", () => {
                    gallery?.classList.add("grid-dimmed");
                    tiles[index]?.classList.add("grid-highlight");
                    tiles[index]?.scrollIntoView({ behavior: "smooth", block: "center" });
                });
                link.addEventListener("mouseleave", clearGrid);
            });
        </script>
    </body>
</html>
