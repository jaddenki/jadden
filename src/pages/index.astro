                        client:visible
                        href="https://www.are.na/jadden-picardal/jadden-picardal-s0qvounprtc"
                        target="_blank"
                        previewText="Jadden Picardal ↗">Are.na</HoverPreviewLink
                    >, <HoverPreviewLink
                        client:visible
                        href="https://x.com/igarakii"
                        target="_blank"
