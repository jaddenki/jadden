---
import BaseHead from "../components/BaseHead.astro";
import CornerNav from "../components/CornerNav.astro";
import { HoverPreviewLink } from "../components/HoverPreviewLink";
import ImageGrid from "../components/ImageGrid.astro";
import InlineAvatar from "../components/InlineAvatar.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import projectMedia from "../data/projects.json";
import "../styles/global.css";

