        aspectRatio: "1/1",
    },
    {
        src: "/img/about/23.webp",
        alt: "sf",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/IMG_3631.webp",
        alt: "me and alicia :3",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/me_alicia_and_my_fuji.webp",
        alt: "me, alicia, and my fuji",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/IMG_3634.webp",
        alt: "me  and fam <3",
        aspectRatio: "1/1",
