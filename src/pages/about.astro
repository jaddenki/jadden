                                                {entry.items.map((item) =>
                                                    item.href ? (
                                                        <a
                                                            href={item.href}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="section-link"
                                                        >
                                                            {item.label}
                                                        </a>
                                                    ) : (
                                                        <span class="section-meta">
                                                            {item.label}
                                                        </span>
                                                    ),
                                                )}
                                            </span>
                                        </div>
                                    </li>
                                ))
                            ) : (
                                <li class="section-item">
                                    <span class="section-meta">
                                        i love nothing
                                    </span>
                                </li>
                            )
                        }
                    </ul> -->
            <!-- </section> -->

            <!-- <RecentlyRead />
                <RecentlyWatched /> -->
            <!-- </aside> -->

            <ImageGrid items={photos} />
        </main>

        <SiteFooter />
        <script>
            document.addEventListener(
                "wheel",
                (event) => {
                    const gallery =
                        document.querySelector<HTMLElement>(
                            ".projects-gallery",
                        );
                    if (!gallery) return;
                    if (
                        event.target instanceof Node &&
                        gallery.contains(event.target)
                    )
                        return;
                    gallery.scrollBy({
                        top: event.deltaY,
                        behavior: "auto",
                    });
                },
                { passive: true },
            );
        </script>
        <script>
            const images = document.querySelectorAll<HTMLImageElement>(
                ".about-layout .gallery-image",
            );
            images.forEach((img, i) => {
                const reveal = () => {
                    img.style.transitionDelay = `${i * 60}ms`;
                    img.classList.add("img-loaded");
                };
                if (img.complete) {
                    reveal();
                } else {
                    img.addEventListener("load", reveal, { once: true });
                }
            });
        </script>
    </body>
</html>
