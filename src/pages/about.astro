---
import BaseHead from "../components/BaseHead.astro";
import CornerNav from "../components/CornerNav.astro";
import ImageGrid from "../components/ImageGrid.astro";
import InlineAvatar from "../components/InlineAvatar.astro";
import RecentlyRead from "../components/RecentlyRead.astro";
import RecentlyWatched from "../components/RecentlyWatched.astro";
import { HoverPreviewLink } from "../components/HoverPreviewLink";
import { SignatureMotion } from "../components/SignatureMotion";
import ThemeToggle from "../components/ThemeToggle.astro";
import { SITE_TITLE } from "../consts";
import "../styles/global.css";

const photos = [
    {
        src: "/img/about/_-1.webp",
        alt: "me on beach",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/23.webp",
        alt: "sf",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/IMG_0958.webp",
        alt: "me looking",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/IMG_3631.webp",
        alt: "me and alicia!",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/IMG_3634.webp",
        alt: "me  and fam <3",
        aspectRatio: "1/1",
    },
    {
        src: "/img/about/IMG_3632.webp",
        alt: "my old gh pfp <3",
        aspectRatio: "1/1",
    },
];

interface FavoriteEntryItem {
    label: string;
    href?: string;
}
interface FavoriteEntry {
    topic: string;
    items: FavoriteEntryItem[];
}
const favorites: FavoriteEntry[] = [
    {
        topic: "Game",
        items: [
            {
                label: "Signalis",
                href: "https://store.steampowered.com/app/1262350/SIGNALIS/",
            },
        ],
    },
    {
        topic: "Artist",
        items: [{ label: "The Marías", href: "https://www.themarias.us" }],
    },
    {
        topic: "Movie",
        items: [
            {
                label: "Look Back",
                href: "https://en.wikipedia.org/wiki/Look_Back_(2024_film)",
            },
        ],
    },
];
---

<!doctype html>
<html lang="en">
    <head>
        <BaseHead title={`about ${SITE_TITLE}`} description="what i'm up to." />
    </head>
    <body>
        <CornerNav current="about" />
        <main class="homepage-container about-layout">
            <div class="content text-reveal">
                <section
                    class="about-bio text-reveal"
                    style="--reveal-order: 0"
                    aria-label="About me"
                >
                    <p style="--reveal-order: 0">A little bit about me:</p>
                    <p style="--reveal-order: 1">
                        I was born in the Philippines and raised in Las Vegas,
                        with periodic visits back that shaped my sense of
                        identity and belonging over time
                    </p>

                    <p style="--reveal-order: 2">
                        I adore games and films that linger, like work that
                        invites reflection or makes familiar ideas feel strange
                        again. I spend a lot of time studying how other people’s
                        work does this & experimenting with those ideas in my
                        own projects
                    </p>
                    <p style="--reveal-order: 3">
                        In fact, I make my own<InlineAvatar
                            src="https://avatars.githubusercontent.com/fruitjamms"
                            alt="jamms gh"
                            width={20}
                            height={20}
                            class="inline-avatar"
                        />
                        <HoverPreviewLink
                            client:visible
                            href="https://jam.ms"
                            target="_blank"
                            previewSrc="/img/previews/jamms.webp"
                            previewAlt="jam.ms preview">games</HoverPreviewLink
                        >
                        with friends and edit <HoverPreviewLink
                            client:visible
                            href="https://tiktok.com/@okigarakii"
                            target="_blank"
                            previewText="TikTok @okigarakii ↗"
                            >videos</HoverPreviewLink
                        > as well
                    </p>
                    <p style="--reveal-order: 4">
                        I'm very inspired by bold projects and ideas.
                        Everything's a bit samey these days, especially in a
                        world of AI-generated everything. All that does is push
                        us to make even better work
                    </p>

                    <p class="mb-8" style="--reveal-order: 5">
                        Hope you enjoy your stay here!<br />
                        Reach me: <span class="email"
                            >jadden [at] jam [dot] ms</span
                        >
                    </p>
                    <div style="--reveal-order: 6">
                        <SignatureMotion
                            client:only="react"
                            style={{ marginTop: "1rem" }}
                        />
                    </div>
                </section>
            </div>

            <!-- <aside class="content-sidebar"> -->
            <!-- <section class="favorites-section"> -->
            <!-- <p class="section-heading">Things I like:</p>
                    <ul class="section-list">
                        {
                            favorites.length > 0 ? (
                                favorites.map((entry) => (
                                    <li class="section-item">
                                        <div class="section-row section-row-favorites">
                                            <span class="favorite-topic">
                                                {entry.topic}
                                            </span>
                                            <span
                                                class="favorite-dots"
                                                aria-hidden="true"
                                            />
                                            <span class="favorite-items">
                                                {entry.items.map((item) =>
                                                    item.href ? (
                                                        <a
                                                            href={item.href}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            class="section-link"
                                                        >
                                                            {item.label}
                                                        </a>
                                                    ) : (
                                                        <span class="section-meta">
                                                            {item.label}
                                                        </span>
                                                    ),
                                                )}
                                            </span>
                                        </div>
                                    </li>
                                ))
                            ) : (
                                <li class="section-item">
                                    <span class="section-meta">
                                        i love nothing
                                    </span>
                                </li>
                            )
                        }
                    </ul> -->
            <!-- </section> -->

            <!-- <RecentlyRead />
                <RecentlyWatched /> -->
            <!-- </aside> -->

            <ImageGrid items={photos} />
        </main>

        <footer>
            <ThemeToggle />
        </footer>
        <script>
            const images = document.querySelectorAll<HTMLImageElement>(
                ".about-layout .gallery-image",
            );
            images.forEach((img, i) => {
                const reveal = () => {
                    img.style.transitionDelay = `${i * 60}ms`;
                    img.classList.add("img-loaded");
                };
                if (img.complete) {
                    reveal();
                } else {
                    img.addEventListener("load", reveal, { once: true });
                }
            });
        </script>
    </body>
</html>
