---
---
<button type="button" class="theme-toggle" id="theme-toggle"><span class="theme-shortcut">(⌘K)</span>&nbsp;<span class="theme-label">Dark Mode</span></button>
<script>
	const btn = document.getElementById('theme-toggle');
	const root = document.documentElement;
	if (btn) {
		const el = btn;
		const label = el.querySelector('.theme-label')!;
		const shortcut = el.querySelector('.theme-shortcut')!;
		if (!/Mac|iPhone|iPad/.test(navigator.platform)) shortcut.textContent = '(Ctrl K)';
		function updateLabel() {
			const isDark = root.getAttribute('data-theme') === 'dark';
			label.textContent = isDark ? 'Light Mode' : 'Dark Mode';
		}
		el.addEventListener('click', () => {
			const isDark = root.getAttribute('data-theme') === 'dark';
			const next = isDark ? 'light' : 'dark';
			root.setAttribute('data-theme', next);
			localStorage.setItem('theme', next);
			updateLabel();
		});
		document.addEventListener('keydown', (e) => {
			if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
			e.preventDefault();
			el.click();
		});
		updateLabel();
	}
</script>
