---
<button type="button" class="theme-toggle js-theme-toggle"><span class="theme-shortcut">(⌘K)</span>&nbsp;<span class="theme-label">Dark Mode</span></button>
<script>
	// Rendered in both the footer and the mobile menu, so handle every instance.
	const buttons = document.querySelectorAll<HTMLButtonElement>('.js-theme-toggle');
	const root = document.documentElement;
	const isMac = /Mac|iPhone|iPad/.test(navigator.platform);

	function updateLabels() {
		const isDark = root.getAttribute('data-theme') === 'dark';
		for (const btn of buttons) {
			btn.querySelector('.theme-label')!.textContent = isDark ? 'Light Mode' : 'Dark Mode';
		}
	}

	function toggleTheme() {
		const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
		root.setAttribute('data-theme', next);
		localStorage.setItem('theme', next);
		updateLabels();
	}

	for (const btn of buttons) {
		if (!isMac) btn.querySelector('.theme-shortcut')!.textContent = '(Ctrl K)';
		btn.addEventListener('click', toggleTheme);
	}

	document.addEventListener('keydown', (e) => {
		if (!(e.metaKey || e.ctrlKey) || e.key.toLowerCase() !== 'k') return;
		e.preventDefault();
		toggleTheme();
	});

	updateLabels();
</script>
