---
import type { LikingEntry } from "../lib/arena";

interface Props {
	entries: LikingEntry[];
	sourceUrl?: string;
}

const { entries, sourceUrl } = Astro.props;

const MONTHS = [
	"Jan",
	"Feb",
	"Mar",
	"Apr",
	"May",
	"Jun",
	"Jul",
	"Aug",
	"Sep",
	"Oct",
	"Nov",
	"Dec",
];

// UTC so date-only seed values aren't shifted back a day by the local timezone.
function monthKey(iso: string): string {
	const d = new Date(iso);
	return `${d.getUTCFullYear()}-${d.getUTCMonth()}`;
}

function monthLabel(iso: string): string {
	const d = new Date(iso);
	return `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
}

// Cluster the (already reverse-chronological) entries into month groups so all
// entries from the same month sit under a single month header.
const groups: { label: string; entries: LikingEntry[] }[] = [];
let lastKey = "";
for (const entry of entries) {
	const key = monthKey(entry.date);
	if (key !== lastKey) {
		groups.push({ label: monthLabel(entry.date), entries: [] });
		lastKey = key;
	}
	groups[groups.length - 1].entries.push(entry);
}

// Running index for the staggered entrance reveal (see .reveal in global.css).
let order = 0;
---

<section class="liking-section" aria-label="Recent Are.na posts">
	<p class="section-heading reveal" style={`--reveal-order: ${order++}`}>
		Recent saves & thoughts from{" "}
		{
			sourceUrl ? (
				<a
					class="liking-source"
					href={sourceUrl}
					target="_blank"
					rel="noopener noreferrer"
				>
				 Are.na
				</a>
			) : (
				"my Are.na"
			)
		}.
	</p>

	{
		entries.length === 0 ? (
			<p class="liking-empty">nothing here yet — check back soon.</p>
		) : (
			<div class="liking-groups">
				{groups.map((group) => (
					<div class="liking-group reveal" style={`--reveal-order: ${order++}`}>
						<p class="liking-month">{group.label}</p>
						<ul class="liking-list">
							{group.entries.map((entry) => (
								<li class="liking-item">
									{entry.imageUrl && (
										<img
											class:list={[
												"liking-thumb",
												{ "is-favicon": entry.isFavicon },
											]}
											src={entry.imageUrl}
											alt={entry.content || ""}
											loading="lazy"
											decoding="async"
										/>
									)}
									{!entry.imageUrl && (
										<span class="liking-thumb-placeholder" aria-hidden="true" />
									)}
									<div class="liking-body">
										{entry.kind !== "Text" && entry.url ? (
											<a
												class="liking-text liking-link"
												href={entry.url}
												target="_blank"
												rel="noopener noreferrer"
											>
												{entry.content}
											</a>
										) : (
											entry.content && <p class="liking-text">{entry.content}</p>
										)}
										{entry.channelTitle && (
											<p class="liking-channel">
												{entry.kind === "Text" && (
													<svg class="liking-text-icon" viewBox="0 0 24 24" fill="none" aria-hidden="true">
														<path
															d="M20.252 6.75C20.252 5.09315 18.9088 3.75 17.252 3.75H6.75195C5.0951 3.75 3.75195 5.09315 3.75195 6.75V21.75L7.50875 19.402C7.66768 19.3027 7.85133 19.25 8.03875 19.25H17.252C18.9088 19.25 20.252 17.9069 20.252 16.25V6.75Z"
															stroke="currentColor"
															stroke-width="1.5"
															stroke-linecap="square"
															stroke-linejoin="round"
														/>
													</svg>
												)}
												in{" "}
												{entry.channelUrl ? (
													<a href={entry.channelUrl} target="_blank" rel="noopener noreferrer">
														{entry.channelTitle}
													</a>
												) : (
													entry.channelTitle
												)}
											</p>
										)}
									</div>
								</li>
							))}
						</ul>
					</div>
				))}
			</div>
		)
	}
</section>
