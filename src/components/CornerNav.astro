---
import AccentToggle from "./AccentToggle.astro";
import ThemeToggle from "./ThemeToggle.astro";
import WebringNav from "./WebringNav.astro";

type NavKey = "home" | "about" | "blog";

interface Props {
	current: NavKey;
}

const { current } = Astro.props;

const links: { key: NavKey; label: string; href: string; shortcut: string }[] = [
	{ key: "home", label: "Home", href: "/", shortcut: "H" },
	{ key: "about", label: "About", href: "/about", shortcut: "A" },
	{ key: "blog", label: "Blog", href: "/blog", shortcut: "B" },
];
---

<nav class="corner-nav" aria-label="Primary">
	<button
		type="button"
		class="corner-nav-toggle"
		aria-expanded="false"
		aria-controls="corner-nav-menu"
	>
		<span class="sr-only">Menu</span>
		<span class="corner-nav-toggle-icon" aria-hidden="true">
			<span class="corner-nav-toggle-bar"></span>
			<span class="corner-nav-toggle-bar"></span>
			<span class="corner-nav-toggle-bar"></span>
		</span>
	</button>
	<div id="corner-nav-menu" class="corner-nav-menu">
		{
			links.map((link) =>
				link.key === current ? (
					<span class="corner-nav-link is-current" aria-current="page">
						<span class="nav-shortcut">({link.shortcut})</span>&nbsp;{link.label}
					</span>
				) : (
					<a href={link.href} class="corner-nav-link" aria-keyshortcuts={link.shortcut}>
						<span class="nav-shortcut">({link.shortcut})</span>&nbsp;{link.label}
					</a>
				),
			)
		}
		<div class="corner-nav-extras">
			<AccentToggle />
			<ThemeToggle />
			<WebringNav />
		</div>
	</div>
</nav>

<script>
	const routes: Record<string, string> = { h: "/", a: "/about", b: "/blog" };

	document.addEventListener("keydown", (event) => {
		if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey || event.repeat) return;
		const target = event.target as HTMLElement | null;
		if (target?.isContentEditable || target?.closest("input, textarea, select")) return;
		const href = routes[event.key.toLowerCase()];
		if (!href || location.pathname.replace(/\/$/, "") === href.replace(/\/$/, "")) return;
		window.location.href = href;
	});

	const nav = document.querySelector<HTMLElement>(".corner-nav");
	const toggle = nav?.querySelector<HTMLButtonElement>(".corner-nav-toggle");
	const menu = nav?.querySelector<HTMLElement>("#corner-nav-menu");

	if (nav && toggle && menu) {
		const mq = window.matchMedia("(max-width: 768px)");

		const setOpen = (open: boolean) => {
			nav.classList.toggle("is-open", open);
			toggle.setAttribute("aria-expanded", String(open));
			document.body.classList.toggle("corner-nav-open", open);
		};

		const closeMenu = () => setOpen(false);

		toggle.addEventListener("click", () => {
			setOpen(!nav.classList.contains("is-open"));
		});

		menu.addEventListener("click", (event) => {
			if (event.target instanceof HTMLAnchorElement) closeMenu();
		});

		document.addEventListener("keydown", (event) => {
			if (event.key === "Escape") closeMenu();
		});

		document.addEventListener("click", (event) => {
			if (!nav.classList.contains("is-open")) return;
			if (event.target instanceof Node && nav.contains(event.target)) return;
			closeMenu();
		});

		mq.addEventListener("change", () => {
			if (!mq.matches) closeMenu();
		});
	}
</script>
