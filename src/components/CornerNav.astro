---
type NavKey = "home" | "about" | "now";

interface Props {
	current: NavKey;
}

const { current } = Astro.props;

const links: { key: NavKey; label: string; href: string }[] = [
	{ key: "home", label: "Home", href: "/" },
	{ key: "about", label: "About", href: "/about" },
	{ key: "now", label: "Now", href: "/now" },
];
---

<nav class="corner-nav" aria-label="Primary">
	{
		links.map((link) =>
			link.key === current ? (
				<span class="corner-nav-link is-current" aria-current="page">
					{link.label}
				</span>
			) : (
				<a href={link.href} class="corner-nav-link">
					{link.label}
				</a>
			),
		)
	}
</nav>
