---
interface ImageItem {
	src: string;
	alt: string;
	aspectRatio: string;
	href?: string;
	/** When set, video pauses on this time (seconds) when idle. Omit or set playContinuously for looping. */
	freezeTime?: number;
	/** When true, video loops continuously when idle instead of pausing on a frame. */
	playContinuously?: boolean;
}

interface Props {
	items: ImageItem[];
	eager?: boolean;
}

const { items, eager = false } = Astro.props;
const isVideoUrl = (url: string) => /\.(webm)(\?|$)/i.test(url);
---

<section class="projects-gallery" aria-label="Projects gallery">
	<div class="gallery-grid">
		{items.map((item) => {
		const isSquare = item.aspectRatio === '1/1';
		const squareClass = isSquare ? 'gallery-item-square' : '';
		const videoTileClass = isSquare ? 'gallery-item-square gallery-video-tile' : 'gallery-video-tile';
		const isVideo = isVideoUrl(item.src);
			const mediaEl = isVideo ? (
				<>
					<span class="sr-only">{item.alt}</span>
					<video
						src={item.src}
						class="gallery-image"
						style={`aspect-ratio: ${item.aspectRatio};`}
						data-freeze-time={item.freezeTime ?? 0}
						data-play-continuously={item.playContinuously ?? false}
						loop
						muted
						preload="metadata"
						playsinline
						aria-hidden="true"
				/>
				<span class="gallery-item-tooltip" aria-hidden="true">{item.alt}</span>
				</>
			) : (
			<>
				<img
					src={item.src}
					alt={item.alt}
					loading={eager ? 'eager' : 'lazy'}
					class="gallery-image"
					style={`aspect-ratio: ${item.aspectRatio};`}
					decoding="async"
					fetchpriority={eager ? 'high' : 'auto'}
				/>
				<span class="gallery-item-tooltip" aria-hidden="true">{item.alt}</span>
			</>
			);
	return item.href ? (
		<a href={item.href} class={isVideo ? videoTileClass : squareClass} style={`--aspect-ratio: ${item.aspectRatio};`}>
			{mediaEl}
		</a>
	) : (
		<div class={isVideo ? videoTileClass : squareClass} {...(isVideo ? { tabindex: 0 } : {})}>
			{mediaEl}
		</div>
	);
		})}
	</div>
</section>

<div class="gallery-edge-blur gallery-edge-blur-bottom" aria-hidden="true">
	<div class="gallery-blur-layer"></div>
	<div class="gallery-blur-layer"></div>
	<div class="gallery-blur-layer"></div>
	<div class="gallery-blur-layer"></div>
</div>

<div class="gallery-cursor-tooltip" id="gallery-tooltip" aria-hidden="true"></div>

<script>
	// --- Cursor-following tooltip with spring tilt ---
	const tooltip = document.getElementById('gallery-tooltip');
	const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
	const hasHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;

	if (tooltip && hasHover) {
		const hoverTooltip = tooltip;
		const TILT_SENSITIVITY = 0.6;
		const TILT_MAX = 5;
		const STIFFNESS = 0.18;
		const DAMPING = 0.72;

		let tiltTarget = 0;
		let tiltCurrent = 0;
		let tiltVelocity = 0;
		let prevMouseX = 0;
		let rafId: number | null = null;

		function springTick() {
			const force = (tiltTarget - tiltCurrent) * STIFFNESS;
			tiltVelocity = (tiltVelocity + force) * DAMPING;
			tiltCurrent += tiltVelocity;
			tiltTarget *= 0.82;
			hoverTooltip.style.rotate = tiltCurrent + 'deg';
			if (Math.abs(tiltCurrent) > 0.05 || Math.abs(tiltVelocity) > 0.05) {
				rafId = requestAnimationFrame(springTick);
			} else {
				tiltCurrent = 0;
				tiltVelocity = 0;
				hoverTooltip.style.rotate = '0deg';
				rafId = null;
			}
		}

		const tiles = document.querySelectorAll<HTMLElement>('.gallery-grid > *');

		document.addEventListener('mousemove', (e) => {
			hoverTooltip.style.left = (e.clientX + 12) + 'px';
			hoverTooltip.style.top = (e.clientY + 16) + 'px';
			if (reducedMotion) return;
			const deltaX = e.clientX - prevMouseX;
			prevMouseX = e.clientX;
			tiltTarget = Math.max(-TILT_MAX, Math.min(TILT_MAX, deltaX * TILT_SENSITIVITY));
			if (!rafId) rafId = requestAnimationFrame(springTick);
		});

		for (const tile of tiles) {
			const label = tile.querySelector('.gallery-item-tooltip')?.textContent?.trim();
			if (!label) continue;
			tile.addEventListener('mouseenter', () => {
				hoverTooltip.textContent = label;
				hoverTooltip.classList.remove('is-exiting');
				hoverTooltip.classList.add('is-entering');
			});
			tile.addEventListener('mouseleave', () => {
				hoverTooltip.classList.remove('is-entering');
				hoverTooltip.classList.add('is-exiting');
			});
		}
	}

	const videos = document.querySelectorAll("video.gallery-image");

	for (const node of videos) {
		if (!(node instanceof HTMLVideoElement)) continue;
		const isLinkTile = !!node.closest("a[href]");
		const playContinuously = node.dataset.playContinuously === "true";
		const freezeTime = Number(node.dataset.freezeTime ?? "0");

		const setFreezeFrame = () => {
			const duration = Number.isFinite(node.duration) ? node.duration : 0;
			const clampedTime = duration > 0
				? Math.min(Math.max(freezeTime, 0), Math.max(duration - 0.001, 0))
				: Math.max(freezeTime, 0);
			if (Math.abs(node.currentTime - clampedTime) > 0.03) {
				node.currentTime = clampedTime;
			}
			node.pause();
		};

		const onIdle = () => {
			if (playContinuously) {
				// keep looping; do nothing (video stays playing)
			} else {
				setFreezeFrame();
			}
		};

		node.addEventListener("loadedmetadata", () => {
			if (playContinuously) {
				void node.play().catch(() => {});
			} else {
				setFreezeFrame();
			}
		});
		node.addEventListener("mouseenter", () => {
			void node.play().catch(() => {});
		});
		node.addEventListener("mouseleave", onIdle);
		node.addEventListener("focusin", () => {
			void node.play().catch(() => {});
		});
		node.addEventListener("focusout", onIdle);
		node.addEventListener("click", (event) => {
			if (isLinkTile) return;
			event.preventDefault();
			if (node.paused) {
				void node.play().catch(() => {});
				return;
			}
			if (playContinuously) {
				node.pause();
			} else {
				setFreezeFrame();
			}
		});

		if (node.readyState >= 1) {
			if (playContinuously) {
				void node.play().catch(() => {});
			} else {
				setFreezeFrame();
			}
		}
	}

	// --- Keyboard access for non-link video tiles ---
	for (const tile of document.querySelectorAll<HTMLElement>('.gallery-grid > [tabindex]')) {
		tile.addEventListener('keydown', (e) => {
			if (e.key !== 'Enter' && e.key !== ' ') return;
			e.preventDefault();
			tile.querySelector<HTMLVideoElement>('video.gallery-image')
				?.dispatchEvent(new MouseEvent('click', { bubbles: false }));
		});
	}
</script>
