---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description } = Astro.props;
---
<script is:inline>
(function(){
	var v = localStorage.getItem('theme');
	if (v === 'dark' || v === 'light') {
		document.documentElement.setAttribute('data-theme', v);
	} else {
		var prefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
		document.documentElement.setAttribute('data-theme', prefersDark ? 'dark' : 'light');
	}
})();
</script>
<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover" />
<link rel="icon" href="/favicon.ico" />
<link rel="preload" href="/fonts/PixelHackers.woff2" as="font" type="font/woff2" crossorigin />
<meta name="generator" content={Astro.generator} />

<!-- Preconnect/prefetch for domains we load resources from -->
<link rel="preconnect" href="https://d2w9rnfcy7mm78.cloudfront.net" crossorigin />
<link rel="preconnect" href="https://github.com" crossorigin />
<link rel="dns-prefetch" href="https://www.google.com" />
<link rel="dns-prefetch" href="https://umami.purduehackers.com" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="title" content={title} />
<meta name="description" content={description} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL('/img/page.png', Astro.site)} />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={Astro.url} />
<meta property="twitter:title" content={title} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={new URL('/img/page.png', Astro.site)} />
<script defer src="https://umami.purduehackers.com/script.js" data-website-id="685a1d18-887b-466a-8bf1-204a65db316e"></script>