---
import ThemeToggle from "./ThemeToggle.astro";
---

<footer>
	<button type="button" class="theme-toggle" id="accent-toggle"><span class="accent-shortcut">(⌘J)</span>&nbsp;Color</button>
	<ThemeToggle />
	<nav class="webring-nav" aria-label="Purdue Hackers webring">
		<a
			href="https://ring.purduehackers.com/previous?host=https://www.jaddens.page"
			class="webring-link"
			aria-label="Previous site in Purdue Hackers webring"
		>
			&lt;
		</a>
		<a
			href="https://ring.purduehackers.com/"
			class="webring-link webring-logo"
			aria-label="Purdue Hackers webring home"
		>
			Purdue Hackers
		</a>
		<a
			href="https://ring.purduehackers.com/next?host=https://www.jaddens.page"
			class="webring-link"
			aria-label="Next site in Purdue Hackers webring"
		>
			&gt;
		</a>
	</nav>
</footer>
<script>
	const accentBtn = document.getElementById('accent-toggle');
	if (accentBtn) {
		if (!/Mac|iPhone|iPad/.test(navigator.platform)) accentBtn.querySelector('.accent-shortcut')!.textContent = '(Ctrl J)';
		accentBtn.addEventListener('click', () => (window as Window & { toggleAccent?: () => void }).toggleAccent?.());
	}
</script>
